#!/bin/bash
# battery-charge-limit [status|off|10-100]
#
# Sets the maximum charge percentage for the internal battery, by writing
# the kernel's charge_control_{start,end}_threshold sysfs attributes.
#
# The battery device is auto-detected (first power_supply exposing
# charge_control_end_threshold); override with BATTERY_DEVICE=<name> if you
# have more than one or auto-detection picks the wrong one.
set -euo pipefail

usage() { echo "Usage: battery-charge-limit [status|off|10-100]" >&2; exit 1; }

# Surfaces failures as a desktop notification too, not just stderr — this is
# also called from a GUI slider with no visible terminal, where a write that
# silently fails just looks like the slider snapping back to the old value
# for no reason.
fail() {
  echo "battery-charge-limit: $1" >&2
  command -v notify-send > /dev/null && notify-send -u critical "Battery charge limit" "$1"
  exit 1
}

detect_device() {
  local f
  for f in /sys/class/power_supply/*/charge_control_end_threshold; do
    [[ -e $f ]] || continue
    basename "$(dirname "$f")"
    return 0
  done
  return 1
}

DEVICE="${BATTERY_DEVICE:-$(detect_device || true)}"
[[ -n $DEVICE ]] || fail "no battery with charge_control_end_threshold found under /sys/class/power_supply/. This laptop's battery driver may not support a charge limit, or needs a newer kernel."

BASE="/sys/class/power_supply/$DEVICE"
START="$BASE/charge_control_start_threshold"
END="$BASE/charge_control_end_threshold"

[[ -w $END ]] || fail "$END is not writable by $(whoami). Run install.sh (or its udev step) first — see the project README."

set_thresholds() {
  local target_start=$1 target_end=$2 cur_end
  cur_end=$(<"$END")
  # Keep start<=end valid at every intermediate write, regardless of which
  # direction we're moving the limit.
  if (( target_start > cur_end )); then
    echo "$target_end" > "$END" || fail "couldn't write $target_end to $END"
    echo "$target_start" > "$START" || fail "couldn't write $target_start to $START"
  else
    echo "$target_start" > "$START" || fail "couldn't write $target_start to $START"
    echo "$target_end" > "$END" || fail "couldn't write $target_end to $END"
  fi

  # Deliberately NOT poking $BASE/uevent to nudge UPower here: this device's
  # own udev rule (93-macsmc-battery-charge-control.rules) has no ACTION
  # filter, so a synthetic "change" event also replays its boot-time restore
  # step, which reimports whatever was last saved to
  # /etc/udev/macsmc-battery.conf and overwrites the value we just set —
  # racing the systemd path-unit that's supposed to save *this* value there
  # first. Silently self-reverting a just-applied threshold is worse than a
  # stale UPower reading, so this stays sysfs-only; callers should read the
  # threshold back via `battery-charge-limit status`, not UPower.
}

case "${1:-status}" in
  status)
    echo "device=$DEVICE start=$(<"$START") end=$(<"$END")"
    ;;
  off|100)
    set_thresholds 100 100
    ;;
  [1-9]|[1-9][0-9])
    n=$1
    (( n >= 10 )) || usage
    set_thresholds 0 "$n"
    ;;
  *)
    usage
    ;;
esac
